{
  "name": "football-project",
  "private": true,
  "version": "0.2.0-beta.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:advance": "tsx scripts/smoke-advance-day.ts",
    "smoke:season": "tsx scripts/smoke-season-transition.ts",
    "smoke:match": "tsx scripts/smoke-match-integration.ts",
    "smoke:context": "tsx scripts/smoke-match-context.ts",
    "profile:match": "tsx scripts/profile-active-match-distribution.ts",
    "smoke:foundation": "tsx scripts/smoke-world-foundation.ts",
    "smoke:population": "tsx scripts/smoke-world-population-integrity.ts",
    "smoke:people-bundle": "tsx scripts/smoke-bundled-world-people.ts",
    "smoke:scouting-recruitment": "tsx scripts/smoke-scouting-recruitment-bridge.ts",
    "smoke:background-club": "tsx scripts/smoke-background-club-integration.ts",
    "test:e2e:stress": "node scripts/e2e-stress.mjs",
    "test:e2e:ui-bridge": "node scripts/e2e-ui-event-bridge.mjs",
    "audit:coverage": "node scripts/audit-module-coverage.mjs",
    "sync:data": "node scripts/sync-openfootball-data.mjs",
    "sync:data:global": "node scripts/sync-openfootball-global.mjs",
    "sync:people": "node scripts/sync-people-2026.mjs",
    "sync:people:reference": "node scripts/sync-people-2026.mjs --include-reference-only",
    "validate:people": "node scripts/validate-people-2026.mjs",
    "sync:people:checked": "npm run sync:people && npm run validate:people",
    "sync:visual:raw": "node scripts/sync-visual-assets-2026.mjs",
    "sync:visual:sanitize": "node scripts/sanitize-visual-identities-2026.mjs",
    "sync:visual:colors": "node scripts/enrich-visual-colors-2026.mjs",
    "sync:visual": "npm run sync:visual:raw && npm run sync:visual:sanitize && npm run sync:visual:colors",
    "sync:rosters:preflight": "node scripts/sanitize-roster-fallback-2026.mjs",
    "sync:rosters": "npm run sync:rosters:preflight && node scripts/sync-wikidata-rosters-2026.mjs",
    "sync:immersive": "npm run sync:people:checked && npm run sync:visual && npm run sync:rosters",
    "sync:all": "npm run sync:data:global && npm run sync:data && npm run sync:immersive"
  },
  "dependencies": {
    "flag-icons": "^7.5.0"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
